{
  "name": "relay-terminal",
  "version": "0.1.0",
  "private": true,
  "author": "Relay Terminal contributors",
  "description": "A cross-platform terminal with opt-in AI command assistance.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiachengg6666-collab/relay-terminal.git"
  },
  "homepage": "https://github.com/jiachengg6666-collab/relay-terminal#readme",
  "bugs": {
    "url": "https://github.com/jiachengg6666-collab/relay-terminal/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "dist-electron/main/index.js",
  "scripts": {
    "postinstall": "node scripts/ensure-node-pty-helper.cjs",
    "dev": "npm run build:main && concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "tsc -p tsconfig.json --noEmit && npm run build:main && npm run build:renderer",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "npm run build && playwright test",
    "smoke:pty": "electron scripts/electron-pty-smoke.cjs",
    "smoke:pty:node": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/electron-node-pty-check.cjs",
    "smoke:shell-integration": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/electron-shell-integration-check.cjs",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "dev.relayterminal.app",
    "productName": "Relay Terminal",
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/shell",
        "to": "shell",
        "filter": ["relay.ps1", "relay.bash"]
      },
      {
        "from": "resources/shell/zsh/.zshrc",
        "to": "shell/zsh/.zshrc"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development"
    }
  }
}
